{
  "name": "bunon",
  "private": true,
  "version": "1.0.0",
  "description": "BUNON website — React + Vite, deployed to GitHub Pages",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "admin": "vite --mode admin --port 5173 --strictPort --open /admin/",
    "dev:shop": "vite --mode shop",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "vite": "8.3.8"
  }
}
